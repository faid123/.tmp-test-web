const puppeteer = require('puppeteer-core');

(async () => {
  const browser = await puppeteer.launch({
    executablePath: '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    headless: 'new',
    args: ['--no-sandbox', '--disable-gpu']
  });
  const page = await browser.newPage();
  await page.setViewport({ width: 1400, height: 900 });
  
  page.on('console', msg => console.log('[browser]', msg.type(), msg.text()));
  page.on('pageerror', err => console.log('[pageerror]', err.message, err.stack?.split('\n')[1]));
  page.on('requestfailed', req => console.log('[netfail]', req.url(), req.failure().errorText));
  
  const resp = await fetch('https://live.api.smartrpdai.com/api/smartrpd/user/login', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify([
      {machine_id: '3a0df9c37b50873c63cebecd7bed73152a5ef616'},
      {username: 'nyunt', password: 'passworD123*'}
    ])
  });
  const userData = await resp.json();
  console.log('[login uuid]', userData.uuid);
  
  await page.evaluateOnNewDocument((user) => {
    localStorage.setItem('loggedInUser', JSON.stringify(user));
  }, userData);
  
  await page.goto('http://localhost:3456/src/pages/2DAnnotation?id=OAJBLhkNOhosdHchWW0OASBBDRw', { waitUntil: 'load', timeout: 30000 });
  console.log('[page url]', page.url());
  await new Promise(r => setTimeout(r, 8000));
  
  // Check state
  const stateInfo = await page.evaluate(() => {
    const params = new URLSearchParams(location.search);
    const id = params.get('id');
    const caseLabelEl = document.getElementById('caseLabel');
    const previewArea = document.getElementById('imagePreviewArea');
    const previewShell = document.querySelector('.jaw-preview-shell');
    const canvas = previewArea?.querySelector('canvas');
    const fallback = document.getElementById('previewFallback');
    return {
      paramId: id,
      caseLabel: caseLabelEl?.textContent,
      hasShell: !!previewShell,
      hasCanvas: !!canvas,
      canvasSize: canvas ? { w: canvas.width, h: canvas.height, rect: canvas.getBoundingClientRect() } : null,
      fallbackText: fallback?.textContent?.trim(),
      fallbackDisplay: getComputedStyle(fallback)?.display,
      previewAreaClasses: previewArea?.className,
      previewAreaRect: previewArea?.getBoundingClientRect(),
    };
  });
  console.log('[state]', JSON.stringify(stateInfo, null, 2));
  
  await page.screenshot({ path: '/tmp/test_preview.png', fullPage: false });
  await browser.close();
})().catch(e => { console.error(e); process.exit(1); });
