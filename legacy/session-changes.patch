+/** Apply the currently selected mesh type to every missing tooth in one action. */
+function applySelectedMeshToAllMissingTeeth() {
+  if (!state.designMode) {
+    setMessage("Lock both arches to use the component catalog.", true);
+    return;
+  }
+
+  const selected = COMPONENT_BY_ID.get(state.selectedComponentId || "");
+  if (!selected || !isMeshComponent(selected)) {
+    setMessage("Select a mesh type in the catalog first (e.g. Tori, Hole).", true);
+    return;
+  }
+
+  let applied = 0;
+  for (const jaw of Object.keys(TOOTH_ORDER)) {
+    for (const toothId of TOOTH_ORDER[jaw]) {
+      const tooth = state.teeth[toothId];
+      if (!tooth || tooth.isPresent) continue;
+
+      ensureToothPlacementState(tooth);
+      const meshComponentIds = [
+        ...new Set(
+          (tooth.componentPlacements || [])
+            .map((entry) => entry.componentId)
+            .filter((id) => isMeshComponent(id))
+        ),
+      ];
+      if (meshComponentIds.length) {
+        removePlacementsByComponentIds(tooth, meshComponentIds);
+      }
+      addPlacement(tooth, selected.id, null);
+      applied += 1;
+    }
+  }
+
+  renderJaws();
+  if (applied === 0) {
+    setMessage("No missing teeth to apply mesh to.", true);
+  } else {
+    setMessage(
+      `${selected.label} applied to ${applied} missing tooth${applied === 1 ? "" : "teeth"}.`,
+      false
+    );
+  }
+}
