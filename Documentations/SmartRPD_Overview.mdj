        {
          "_type": "UMLPackage",
          "_id": "PKG-BUSINESS",
          "_parent": { "$ref": "MDL-SMARTRPD-0001" },
          "name": "Business Overview",
          "documentation": "Capability map of SmartRPD from a business/user perspective. In StarUML: right-click this package > Add Diagram > Use Case Diagram, then drag the actors and use cases below onto the canvas (StarUML lays out the shapes automatically).",
          "ownedElements": [
            { "_type": "UMLActor", "_id": "ACT1", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Clinician / Dental Technician" },
            { "_type": "UMLActor", "_id": "ACT2", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "External Backend (smartrpdai.com)", "documentation": "Third-party service, not part of this codebase. Owns authentication, case data, and file storage." },

            { "_type": "UMLUseCase", "_id": "UC1", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Login & Authenticate", "documentation": "Password login; OTP step exists in code but is currently disabled.\nFiles: src/js/login.js, src/js/authGuard.js" },
            { "_type": "UMLUseCase", "_id": "UC2", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Browse & Manage Case List", "documentation": "Browse, duplicate, rename, delete, open, download and share cases.\nFiles: src/pages/case_list.html, src/js/caseManagement.js" },
            { "_type": "UMLUseCase", "_id": "UC3", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Filter Cases", "documentation": "Client-side filtering of the case list.\nFunction: applyClientFilters() in src/js/caseManagement.js" },
            { "_type": "UMLUseCase", "_id": "UC4", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Change Case Status", "documentation": "Update a case's workflow status from the case list.\nFile: src/js/caseManagement.js (status dropdown handler, valueToApiStatus)" },
            { "_type": "UMLUseCase", "_id": "UC5", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Create New Case", "documentation": "Create a case, upload STL/reference files, assign team members, send invitations.\nFiles: src/js/createCase.js, css/createCase.css" },
            { "_type": "UMLUseCase", "_id": "UC6", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Upload Additional STL Files (1-4)", "documentation": "Attach up to four extra reference STL files to a case (jaw_stls_extra_slot_1..4).\nFiles: src/js/2D/preview3D.js, src/pages/2DAnnotation.html" },
            { "_type": "UMLUseCase", "_id": "UC7", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Design RPD (2D Annotation)", "documentation": "Place/edit RPD components (rests, clasps, bars, plates, connectors) on jaw diagrams.\nFiles: src/pages/2DAnnotation.html, src/js/2D/*" },
            { "_type": "UMLUseCase", "_id": "UC8", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "View 3D Jaw Model", "documentation": "Render jaw meshes, design overlays, artificial teeth, heatmaps.\nFiles: src/pages/ThreeDViewer.html, src/index.js, src/newControls.js" },
            { "_type": "UMLUseCase", "_id": "UC9", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Share Case via QR Code", "documentation": "Generate a scannable QR code for the 3D viewer link.\nFile: src/js/caseManagement.js (showThreeDViewerQr)\nNote: present on branch nyunt/dev-W7.1, not yet merged into shafik_nyunt_2_integration." },
            { "_type": "UMLUseCase", "_id": "UC10", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "View Case Dashboard", "documentation": "Per-case production overview: process steps, captures, roles.\nFile: src/js/dashboard.js" },
            { "_type": "UMLUseCase", "_id": "UC11", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Generate Case Report", "documentation": "Compile a case's design/annotations/notes into a downloadable .docx report.\nFiles: src/js/2D/noticeboard.js (generateReport, buildReportHtml), src/js/accessibility.js (reportHtmlToDocxBytes)" },
            { "_type": "UMLUseCase", "_id": "UC12", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Review Version History", "documentation": "Review and compare past design iterations for a case.\nFiles: src/pages/VersionHistory.html, src/js/versionHistory.js" },
            { "_type": "UMLUseCase", "_id": "UC13", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Chat & Notifications", "documentation": "In-case chat and notification bell.\nFiles: src/js/chat.js, src/js/notifications.js" },
            { "_type": "UMLUseCase", "_id": "UC14", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Download Case Files (STL/OFF)", "documentation": "Download a case's raw STL/OFF model files directly, separate from the compiled .docx report.\nFunctions: downloadCaseFiles(), triggerBlobDownload() in src/js/caseManagement.js" },
            { "_type": "UMLUseCase", "_id": "UCSYNC", "_parent": { "$ref": "PKG-BUSINESS" }, "name": "Sync with Backend API", "documentation": "Shared dependency: every data-bearing use case ultimately reads/writes through the external smartrpdai.com API." },

